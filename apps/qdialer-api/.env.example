NODE_ENV=development
QDIALER_API_HOST=127.0.0.1
QDIALER_API_PORT=8787
QDIALER_MODE=mock

# qDialer app data. Use Postgres for qDialer-native rules, audits, snapshots, and SaaS metadata.
DATABASE_URL=postgres://qdialer:change-me@127.0.0.1:5432/qdialer

# Optional cache and realtime fanout.
REDIS_URL=redis://127.0.0.1:6379

# VICIdial should be read-only for reporting queries.
VICI_DB_READONLY_URL=mysql://readonly:change-me@127.0.0.1:3306/asterisk

# VICIdial API connector should be used for controlled writes/actions only.
VICIDIAL_API_BASE_URL=http://127.0.0.1/agc/api.php
VICIDIAL_API_USER=
VICIDIAL_API_PASS=
